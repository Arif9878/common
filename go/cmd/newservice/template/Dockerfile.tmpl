FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/{{.Name}} .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/{{.Name}} /{{.Name}}
ARG VERSION=dev
# The version in every log line, span and metric, unless the deployment
# sets OTEL_RESOURCE_ATTRIBUTES itself.
ENV OTEL_RESOURCE_ATTRIBUTES=service.version=${VERSION}
EXPOSE 8080 9090
ENTRYPOINT ["/{{.Name}}"]
